#!/bin/sh
{{- if eq .profile "work" }}
if  command -v just >/dev/null 2>&1; then
    echo "just already installed"
else
    if ! command -v pipx >/dev/null 2>&1 && ! python3 -m pipx --version >/dev/null 2>&1; then
        python3 -m pip --version >/dev/null 2>&1 || python3 -m ensurepip --user --default-pip >/dev/null 2>&1
        python3 -m pip install --user pipx || python3 -m pip install --user --break-system-packages pipx
    fi
    python3 -m pipx install rust-just
fi
{{- end }}
